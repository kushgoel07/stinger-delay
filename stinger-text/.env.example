# Copy to .env and fill in. Never commit .env.

# Person C: xAI Grok
XAI_API_KEY=xai-your-key-here
# grok-4-fast-non-reasoning was retired 15 May 2026; non-reasoning work uses grok-4.3
# with reasoning effort "none" (docs.x.ai/developers/migration/may-15-retirement).
GROK_MODEL=grok-4.3
# Sent as reasoning_effort only when set; dropped automatically if the API rejects it.
GROK_REASONING_EFFORT=none
# Per-round Grok timeout in seconds (PRD: 3 s)
GROK_TIMEOUT_S=3

# Person B: public GT bus map. bus.gatech.edu and gatech.transloc.com serve the same feed.
BUS_FEED_HOST=bus.gatech.edu
BUS_FEED_KEY=8882812681

# Person A: BlueBubbles and admin
BB_URL=http://localhost:1234
BB_PASSWORD=your-bluebubbles-password
# Comma-separated iMessage handles allowed to run /clock, /mode, /where, /status
ADMIN_HANDLES=+14045550100,admin@example.com
# Personal-Apple-ID fallback only
TRIGGER_WORD=stinger
